{
  "name": "ai-dial-admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ai-dial-admin",
  "projectType": "application",
  "tags": ["type:app"],
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/ai-dial-admin",
        "assets": []
      },
      "configurations": {
        "development": {
          "outputPath": "apps/ai-dial-admin"
        },
        "production": {
          "generatePackageJson": true
        }
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "ai-dial-admin:build",
        "dev": true
      },
      "configurations": {
        "development": {
          "buildTarget": "ai-dial-admin:build:development",
          "dev": true
        },
        "production": {
          "buildTarget": "ai-dial-admin:build:production",
          "dev": false
        }
      }
    },
    "export": {
      "executor": "@nx/next:export",
      "options": {
        "buildTarget": "ai-dial-admin:build:production"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.outputFile}"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ai-dial-admin",
        "command": "tsc -p tsconfig.app.json --noEmit"
      }
    },
    "typecheck-specs": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ai-dial-admin",
        "command": "tsc -p tsconfig.spec.json --noEmit"
      }
    }
  }
}
