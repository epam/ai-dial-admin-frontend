{
  "env": {
    "ANTHROPIC_BASE_URL": "https://ai-proxy.lab.epam.com/anthropic",
    "ANTHROPIC_API_KEY": "dial-7ovhooiu8munprkdztivq3xlpxb",
    "ANTHROPIC_CUSTOM_HEADERS": "Api-Key: dial-7ovhooiu8munprkdztivq3xlpxb",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-5.3",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-5.3",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-5.3-flash"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-env-local-access.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for local env file access"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.claude/commands/*.md|*.claude/rules/*.md|*.claude/skills/*.md|*.claude/settings.json|*.cursor/rules/*.mdc|*.mcp.json|*/AGENTS.md|*/CLAUDE.md|*openspec/config.yaml) node \"$CLAUDE_PROJECT_DIR/scripts/validate-agent-docs.mjs\" \"$f\" >/dev/null || exit 2 ;; esac",
            "timeout": 30,
            "statusMessage": "Validating agent configuration"
          }
        ]
      }
    ]
  }
}
